# Your own sheet link + tab names — copy my-sheet.txt.example to create it.
my-sheet.txt

# Secrets — never commit a real connection string or key.
.env
.env.*
!.env.example

# Vercel + Node
.vercel/
node_modules/

# Throwaway diagnostics / OS junk
_diag.html
.DS_Store
Thumbs.db
*.log

# Source PDFs for the grammar course — kept local, never published.
*.pdf

# Exam papers (PDF) — kept local, never published. The exam audio is tracked
# so the deployed app can actually play the listening tracks.
exam/**/*.pdf
exam/**/Thumbs.db

# Agent guidance — kept local, never committed.
AGENTS.md

# Playwright output
test-results/
playwright-report/
blob-report/

# Local account store (no MONGODB_URI)
.data/
